# gallery-collector の設定の effectful-yaml 版。
#
# 評価の規約:
#   ホストはこのファイルを素の YAML として読み、$ 式を含む欄（labels の値、collect、id、discovery）
#   だけをそれぞれ独立の文書として、要求ごとのパラメータを与えて評価する。
#   パラメータは id（品番の番号部）と label（一致したラベル名）である。
#
# ホスト登録の演算:
#   http.json  : URL または {url, method, body}。JSON を取得して値として返す。
#   page.text  : セレクタ。取得済みページの最初の一致のテキスト。無ければツールのエラー。
#   page.image : セレクタ。最初に一致した画像の URL。
#   page.images: セレクタ。一致した画像の URL のリスト。
#   page.exists: セレクタ。一致の有無。
#   page.match : 正規表現。ページソースへの一致のリスト。
#   page.* の対象ページは、labels の値が組み立てたパスをホストが取得したものである。

agent:
  endpoint: http://172.29.208.1:1234
  model: gemma-4-26b-a4b

sites:
  1pondo:
    url: https://www.1pondo.tv/movies
    labels:
      "*-1pon":
        $do:
        - $let:
            id: {$std.param: id}
        - /${id}/
    collect:
      $do:
      - $let:
          id: {$std.param: id}
          detail:
            $http.json: https://www.1pondo.tv/dyn/phpauto/movie_details/movie_id/${id}.json
          gallery:
            $http.json: https://www.1pondo.tv/dyn/dla/json/movie_gallery/${id}.json
      - title: ${detail.Title}
        thumbnail: ${detail.ThumbHigh}
        images:
          $std.list:
            $do:
            - $let:
                row:
                  $std.each: ${gallery.Rows}
            - $std.where: ${row.Protected == false}
            - $std.resolve:
                base: https://www.1pondo.tv/dyn/dla/images/
                path: ${row.Img}

  fc2-ppv:
    url: https://adult.contents.fc2.com/article
    cookies:
      GDPRCHECK: "true"
    labels:
      fc2-ppv:
        $do:
        - $let:
            id: {$std.param: id}
        - /${id}/
    collect:
      # 販売終了・削除済みページの検出を失敗作用にする。捕捉しなければ収集全体のエラーになる。
      $if:
        $page.exists: .items_notfound_header
      $then:
        $std.fail: unavailable article
      $else:
        title:
          $page.text: div.items_article_headerInfo h3
        thumbnail:
          $page.image: .items_article_MainitemThumb img
        images:
          $page.images: .items_article_SampleImagesArea img

  zipang:
    url: http://zipang.xxx/movie
    labels:
      zipang:
        $do:
        - $let:
            id: {$std.param: id}
        - /detail_${id}.html
    collect:
      title:
        $page.text: "#contents h2:first-child"
      thumbnail:
        $page.image: "#movie_s1 .movie_l1 img"
      images:
        $page.images: "#contents .block21 img"

  heyzo:
    url: https://www.heyzo.com/moviepages
    labels:
      heyzo:
        $do:
        - $let:
            id: {$std.param: id}
        - /${id}/index.html
    collect:
      title:
        $page.text: "#movie h1"
      images:
        # ギャラリーは document.write で生成されるため、セレクタではなくソースへの正規表現で拾う。
        $page.match: '/contents/\d+/\d+/gallery/\d+\.jpg'

  dmm:
    # ルーティング用のラベル一覧。ここは素のデータであり、ID の組み立ては下の id が行う。
    labels: [adn, apak, cawd, ddob, ebod, ebwh, dpmi, flav, focs, fway, hmn, huntb,
             juq, ktkc, ksbj, miaa, miab, mida, midv, mifd, mimk, mird, mizd, mkmp,
             mukd, mum, oae, ofje, pfes, pppe, prin, real, rki, sora, ssis, ssni,
             stcv, ure, urkk, waaa, sone, ienfh, akdl, akdld, fsdss, iesm, mogi,
             mtall, sdam, sdhs, sdmu, stars, start, gas, honb, kamef, rebd, san,
             sero, stsk, star, madv, ddhp, hodv, snos, blor, nhdtc, fone, hunta,
             pred, mudr, cjod, nima, gvh, prtd, dldss, ssr, mibb, jur, maan, mima,
             hmrk, sgm, chuc]
    id:
      # ラベルと番号から DMM のコンテンツ ID を組み立てる。既定の形は {接頭辞なし}{label}00{番号}。
      # 例外表には既定と違う部分だけを書く。
      #   pre  : 接頭辞（既定は空）
      #   sep  : ラベルと番号の間（既定は "00"）
      #   name : ID に使うラベル名の差し替え（akdld は akdl の品番を使う）
      $do:
      - $let:
          label: {$std.param: label}
          num: {$std.param: id}
          exceptions:
            ienfh: {pre: "1", sep: ''}
            akdl: {pre: "1"}
            akdld: {pre: "1", name: akdl}
            fsdss: {pre: "1"}
            iesm: {pre: "1"}
            mogi: {pre: "1"}
            mtall: {pre: "1"}
            sdam: {pre: "1"}
            sdhs: {pre: "1"}
            sdmu: {pre: "1"}
            stars: {pre: "1"}
            start: {pre: "1"}
            star: {pre: "1"}
            nhdtc: {pre: "1"}
            dldss: {pre: "1"}
            ssr: {pre: "1"}
            gas: {pre: "71"}
            gvh: {pre: "13"}
            sgm: {pre: "143"}
            hodv: {pre: "41", sep: "0"}
            honb: {pre: h_1133}
            kamef: {pre: h_1350}
            rebd: {pre: h_346}
            san: {pre: h_796}
            sero: {pre: h_422}
            stsk: {pre: h_1605}
            maan: {pre: h_1711, sep: "0"}
            hmrk: {pre: h_1711}
            chuc: {pre: h_491}
            fone: {pre: h_491}
            ddhp: {sep: ''}
          # 例外表をラベルで引く。無ければ既定だけの空の仕様にする。
          spec:
            $std.opt:
              $std.lookup:
                in: ${exceptions}
                key: ${label}
            $default: {}
          pre:
            $std.opt: ${spec.pre}
            $default: ''
          sep:
            $std.opt: ${spec.sep}
            $default: '00'
          name:
            $std.opt: ${spec.name}
            $default: ${label}
      - ${pre}${name}${sep}${num}
    discovery:
      # 検索で ID の候補を引く。ラベルを大文字化して「LABEL 番号」を検索語にする。
      $do:
      - $let:
          label: {$std.param: label}
          num: {$std.param: id}
          word:
            $std.upper: ${label}
          res:
            $http.json:
              url: https://api.video.dmm.co.jp/graphql
              method: POST
              body:
                query: |
                  query Search($queryWord: String, $limit: Int!, $sort: ContentSearchPPVSort!, $facetLimit: Int!, $excludeUndelivered: Boolean!) {
                    legacySearchPPV(limit: $limit, sort: $sort, queryWord: $queryWord, facetLimit: $facetLimit, includeExplicit: true, excludeUndelivered: $excludeUndelivered) {
                      result { contents { id } }
                    }
                  }
                variables:
                  queryWord: ${word} ${num}
                  limit: 5
                  sort: RECOMMENDED
                  facetLimit: 1
                  excludeUndelivered: false
      - $std.list:
          $do:
          - $let:
              c:
                $std.each: ${res.data.legacySearchPPV.result.contents}
          - ${c.id}
    collect:
      $do:
      - $let:
          id: {$std.param: id}
          res:
            $http.json:
              url: https://api.video.dmm.co.jp/graphql
              method: POST
              body:
                query: |
                  query($id: ID!) {
                    ppvContent(id: $id) {
                      title
                      packageImage { largeUrl }
                      sampleImages { largeImageUrl }
                    }
                  }
                variables:
                  id: ${id}
          c: ${res.data.ppvContent}
      - title: ${c.title}
        thumbnail: ${c.packageImage.largeUrl}
        images:
          $std.list:
            $do:
            - $let:
                img:
                  $std.each: ${c.sampleImages}
            - ${img.largeImageUrl}
